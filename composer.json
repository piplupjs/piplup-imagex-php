{
  "name": "piplup/imagex",
  "description": "Headless PHP image optimization library",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "Piplup\\ImageX\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Piplup\\ImageX\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
