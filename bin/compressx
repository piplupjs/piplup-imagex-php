#!/usr/bin/env php
<?php
require __DIR__ . '/../vendor/autoload.php';

use Piplup\ImageX\Console\GenerateCommand;
use Piplup\ImageX\Console\ConvertCommand;
use Piplup\ImageX\Console\RegenerateCommand;

$argvCopy = $GLOBALS['argv'];
array_shift($argvCopy); // script name
$command = $argvCopy[0] ?? null;
$args = array_slice($argvCopy, 1);

$map = [
    'generate' => GenerateCommand::class,
    'convert' => ConvertCommand::class,
    'regenerate' => RegenerateCommand::class,
];

if (!$command || !isset($map[$command])) {
    echo "Usage: php bin/compressx [generate|convert|regenerate] [args]\n";
    exit(1);
}

$class = $map[$command];
if (!class_exists($class)) {
    echo "Command class not found: $class\n";
    exit(2);
}

$inst = new $class();
$exit = $inst->run($args);
exit((int)$exit);
